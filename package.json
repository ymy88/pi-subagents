{
  "name": "@ymy88/pi-subagents",
  "version": "0.24.0",
  "description": "Fork of @tintinweb/pi-subagents that reaches its four tools through pi's codemode instead of declaring them to the model, keeping about 32k characters of tool declarations out of every request. Claude Code-style sub-agents and workflow orchestration for pi.",
  "author": "tintinweb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ymy88/pi-subagents.git"
  },
  "homepage": "https://github.com/ymy88/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/ymy88/pi-subagents/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "codemode",
    "context-window",
    "subagent",
    "sub-agents",
    "agent",
    "multi-agent",
    "orchestration",
    "workflow",
    "claude-code",
    "autonomous"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.1.0",
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "@earendil-works/pi-tui": ">=1.1.0",
    "typebox": "*"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "nanoid": "^5.1.16"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run e2e --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --fix src/ test/",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "bench:ab": "node test/perf/ab.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^25.5.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "typebox": "^1.3.27",
    "typescript": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "video": "https://github.com/ymy88/pi-subagents/raw/master/media/demo.mp4",
    "image": "https://github.com/ymy88/pi-subagents/raw/master/media/screenshot.png"
  }
}
